{
  "name": "dragons-agent",
  "version": "0.1.0",
  "description": "Terminal-native coding agent with explicit local tool authorization.",
  "keywords": [
    "ai",
    "agent",
    "coding-agent",
    "cli",
    "terminal"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frknaykc/dragons-agent.git"
  },
  "homepage": "https://github.com/frknaykc/dragons-agent#readme",
  "bugs": {
    "url": "https://github.com/frknaykc/dragons-agent/issues"
  },
  "type": "module",
  "types": "./dist/runtime.d.ts",
  "exports": {
    ".": "./dist/runtime.js",
    "./runtime": "./dist/runtime.js",
    "./plugins": "./dist/plugins.js",
    "./lifecycle-hooks": "./dist/lifecycle-hooks.js",
    "./plugin-catalog": "./dist/plugin-catalog.js",
    "./skill-hub": "./dist/skill-hub.js",
    "./skill-management": "./dist/skill-management.js",
    "./skill-curator": "./dist/skill-curator.js",
    "./external-memory": "./dist/external-memory.js",
    "./cron-schedule": "./dist/cron-schedule.js",
    "./cron-scheduler": "./dist/cron-scheduler.js",
    "./cron-store": "./dist/cron-store.js",
    "./cron-runner": "./dist/cron-runner.js",
    "./session-loop": "./dist/session-loop.js",
    "./session-loop-runtime": "./dist/session-loop-runtime.js",
    "./persistent-goals": "./dist/persistent-goals.js",
    "./persistent-goal-store": "./dist/persistent-goal-store.js",
    "./persistent-goals-runtime": "./dist/persistent-goals-runtime.js",
    "./kanban": "./dist/kanban.js",
    "./kanban-worker": "./dist/kanban-worker.js",
    "./kanban-worker-process": "./dist/kanban-worker-process.js",
    "./kanban-worker-lane": "./dist/kanban-worker-lane.js",
    "./mixture-of-agents": "./dist/mixture-of-agents.js",
    "./batch-queue": "./dist/batch-queue.js",
    "./batch-runner": "./dist/batch-runner.js",
    "./profiles": "./dist/profiles.js",
    "./skills": "./dist/skills.js",
    "./remote/client": "./dist/remote/client.js",
    "./remote/server": "./dist/remote/server.js",
    "./remote/runtime": "./dist/remote/runtime.js",
    "./shared-runtime": "./dist/shared-runtime.js"
  },
  "bin": {
    "dragons": "./dist/cli.js"
  },
  "files": [
    "dist",
    "catalog/plugins/hello/1.0.0/plugin.json",
    "catalog/plugins/hello/1.1.0/plugin.json",
    "catalog/skills/quick-notes/1.0.0/SKILL.md",
    "catalog/skills/quick-notes/1.1.0/SKILL.md",
    "native/checkpoint-win32/build/Release/checkpoint_win32.node",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "package.json",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/acceptance-*.js",
    "!dist/acceptance-*.d.ts",
    "!dist/provider-acceptance.js",
    "!dist/provider-acceptance.d.ts",
    "!dist/live-smoke.js",
    "!dist/live-smoke.d.ts",
    "!dist/chatgpt-stream-trace.js",
    "!dist/chatgpt-stream-trace.d.ts",
    "!dist/mcp-mock-server.js",
    "!dist/mcp-mock-server.d.ts",
    "!dist/mcp-official-sdk-server.js",
    "!dist/mcp-official-sdk-server.d.ts"
  ],
  "scripts": {
    "build": "pnpm clean && node scripts/build-checkpoint-native.mjs && tsc -p tsconfig.json",
    "typecheck": "pnpm build && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "pnpm build:tests && node scripts/run-tests.mjs",
    "dragons": "pnpm build && node dist/cli.js",
    "desktop": "pnpm build && electron desktop/main.mjs",
    "desktop:pack": "pnpm build && electron-builder --config electron-builder.json --dir --publish never",
    "desktop:dist": "pnpm build && electron-builder --config electron-builder.json --publish never",
    "verify:desktop-package": "node scripts/verify-desktop-package.mjs",
    "acceptance:installed": "node scripts/verify-desktop-installed.mjs",
    "acceptance:installed-cron": "node scripts/verify-desktop-installed-cron.mjs",
    "acceptance:installed-loop": "node scripts/verify-desktop-installed-cron.mjs --loop",
    "acceptance:installed-loop-live": "node scripts/verify-desktop-installed-cron.mjs --loop-live",
    "acceptance:installed-goal": "node scripts/verify-desktop-installed-cron.mjs --goal",
    "acceptance:installed-kanban-worker": "node scripts/verify-desktop-installed-kanban-worker.mjs",
    "acceptance:installed-batch": "node scripts/verify-desktop-installed-batch.mjs",
    "acceptance:installed-mixture": "node scripts/verify-desktop-installed-mixture.mjs",
    "acceptance:installed-mixture-synthesis": "node scripts/verify-desktop-installed-mixture-synthesis.mjs",
    "acceptance:installed-mixture-renderer": "node scripts/verify-desktop-installed-mixture-synthesis.mjs --renderer",
    "acceptance:installed-mixture-live": "node scripts/verify-desktop-installed-mixture-live.mjs",
    "acceptance:desktop-dmg": "node scripts/verify-desktop-dmg.mjs",
    "remote": "pnpm build && node scripts/serve-remote.mjs",
    "acceptance:desktop": "pnpm build && electron scripts/verify-desktop-smoke.mjs",
    "acceptance:desktop-cron": "pnpm build && electron scripts/verify-desktop-smoke.mjs --cron",
    "acceptance:desktop-loop": "pnpm build && electron scripts/verify-desktop-smoke.mjs --loop",
    "acceptance:desktop-goal": "pnpm build && electron scripts/verify-desktop-smoke.mjs --goal",
    "acceptance:shared": "pnpm build && electron scripts/verify-desktop-smoke.mjs --shared",
    "smoke:live": "pnpm build:tests && node .test-build/acceptance/live-smoke.js",
    "acceptance:openai": "pnpm build:tests && node .test-build/acceptance/acceptance-openai.js",
    "acceptance:chatgpt": "pnpm build:tests && node .test-build/acceptance/acceptance-chatgpt.js",
    "acceptance:provider": "pnpm build:tests && node .test-build/acceptance/acceptance-live.js",
    "acceptance:phase2-chatgpt": "pnpm build:tests && node .test-build/acceptance/phase2-chatgpt.js",
    "acceptance:mcp": "pnpm build:tests && node --test .test-build/acceptance/m32-mcp-acceptance.test.js",
    "acceptance:mcp-chatgpt": "pnpm build:tests && node .test-build/acceptance/mcp-chatgpt.js",
    "verify:package": "pnpm build && node scripts/verify-package.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:pack": "pnpm release:check && pnpm pack",
    "clean": "node scripts/clean-build.mjs",
    "build:tests": "pnpm build && node scripts/clean-build.mjs tests && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@napi-rs/keyring": "2.0.0",
    "openai": "^7.9.0",
    "string-width": "^8.2.2"
  },
  "devDependencies": {
    "@electron/asar": "4.3.0",
    "@types/node": "^22.0.0",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "node-gyp": "12.4.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.17.0"
}
